{
  "name": "simple-authorizenet-sdk",
  "description": "Simple Authorize.net SDK for Node.js.",
  "version": "2.1.1",
  "type": "module",
  "main": "dist/cjs/index.cjs",
  "module": "dist/esm/index.js",
  "types": "types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.cjs",
      "default": "./dist/esm/index.js"
    },
    "./worker": {
      "types": "./types/worker.d.ts",
      "import": "./dist/esm/worker.js",
      "require": "./dist/cjs/worker.cjs",
      "default": "./dist/esm/worker.js"
    }
  },
  "files": [
    "dist",
    "types",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "build": "tsup",
    "prepublishOnly": "npm run lint && npm run build",
    "prepare": "husky"
  },
  "author": "nswbmw",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nswbmw/simple-authorizenet-sdk.git"
  },
  "keywords": [
    "authorize",
    "authorize.net",
    "AuthorizeNet"
  ],
  "devDependencies": {
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "eslint": "9.39.4",
    "husky": "9.1.7",
    "neostandard": "0.13.0",
    "tsup": "8.5.1"
  },
  "dependencies": {
    "https-proxy-agent": "9.1.0",
    "lite-request": "1.1.0",
    "socks-proxy-agent": "10.1.0"
  }
}
